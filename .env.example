# FalkorDB connection (docker compose sets FALKOR_HOST=falkordb for the app container)
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_USERNAME=
FALKOR_PASSWORD=
# Set FALKOR_SSL=true if your hosted FalkorDB requires TLS (e.g. FalkorDB Cloud)
FALKOR_SSL=false
GRAPH_NAME=whybase

# LLM via LiteLLM. Leave LLM_MODEL empty (or the key unset) to run in offline mode.
# Examples: gemini/gemini-3.1-flash-lite, anthropic/claude-sonnet-5-5, openai/gpt-4o-mini
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
